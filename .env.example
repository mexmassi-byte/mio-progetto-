# ThePaddockView — environment variables
#
# Copy this file to `.env.local` and fill in the values.
# Only variables prefixed with VITE_ are exposed to the client bundle.
# `.env.local` is git-ignored; this example is committed as documentation.
#
# NOTHING HERE IS REQUIRED: with no .env file the app runs on real Formula 1
# data from the public, key-less Jolpica-F1 and OpenF1 endpoints.

# Active data source:
#   api  (default) real data + automatic per-slice fallback to placeholders
#   mock           fully deterministic placeholder data
#   http           the skeleton for a private/paid API (see httpSource.ts)
VITE_DATA_SOURCE=

# Public F1 endpoints. Override only to point at a mirror or your own proxy.
VITE_JOLPICA_BASE_URL=
VITE_OPENF1_BASE_URL=

# Base URL of a private F1 API consumed by httpSource.
# Leave unset to fall back to the same-origin "/api/v1".
# Example:
#   VITE_API_BASE_URL=https://api.thepaddockview.com/v1
#
# ⚠️ A key placed in any VITE_* variable is compiled into the bundle and is
# readable by anyone. For a paid provider, keep the key on a server-side proxy
# and point VITE_API_BASE_URL at that proxy instead.
VITE_API_BASE_URL=

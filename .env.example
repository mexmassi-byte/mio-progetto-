# ThePaddockView — environment variables
#
# Copy this file to `.env.local` and fill in the values.
# Only variables prefixed with VITE_ are exposed to the client bundle.
# `.env.local` is git-ignored; this example is committed as documentation.

# Base URL of the Formula 1 data API consumed by the future httpSource.
# Leave unset to fall back to the same-origin "/api/v1".
# Example:
#   VITE_API_BASE_URL=https://api.thepaddockview.com/v1
VITE_API_BASE_URL=

+// Records the showcase film of the ANIMA FLY concept, deterministically: record mode (?rec), a fixed scroll
+// curve, one screenshot per frame (CDP), 30 fps, 1280x800 at 1.5x (downscale when encoding).
+// Serve this folder first:  python3 -m http.server 4321   then:  node rec.mjs <frames dir> desktop 40
+import { createRequire } from 'node:module';
+const require = createRequire(import.meta.url);
+const { chromium } = require('playwright');
+import fs from 'node:fs';
+const OUT = process.argv[2]; fs.mkdirSync(OUT, { recursive: true });
+const mobile = process.argv[3] === 'mobile';
+const DUR = Number(process.argv[4] || 70), FPS = 30;
+const vp = mobile ? { width: 390, height: 844 } : { width: 1280, height: 800 };
+const scale = mobile ? 1080 / 390 : 1.5;
+const b = await chromium.launch();
+const p = await b.newPage({ viewport: vp, deviceScaleFactor: scale });
+await p.goto('http://127.0.0.1:4321/index.html?rec');
+await p.evaluate(() => window.__af.ready);
+const info = await p.evaluate(() => window.__af.info());
+const maxY = info.docH - info.vh;
+// the route of the scroll: [time s, scroll y]; holds where the page has something to read
+const fl = info.flight, hero = (u) => fl.top + u * (fl.height - info.vh);
+const sec = async (s, f = 0) => p.evaluate(([sel, ff]) => { const el = document.querySelector(sel); const r = el.getBoundingClientRect(); return r.top + scrollY + ff * r.height; }, [s, f]);
+const fleetTop = await sec('#fleet'), fleetEnd = fleetTop + info.fleet.height - info.vh;
+const K = [
+  [0, 0], [1.2, 0],
+  [5.5, hero(0.16)], [8, hero(0.3)], [11, hero(0.5)], [13.5, hero(0.62)], [16, hero(0.72)], [19, hero(0.86)], [21.5, hero(1.0)], [22.2, hero(1.0)],
+  [23.8, await sec('#plan')], [25.2, await sec('#plan')],
+  [26.6, await sec('.time')], [27.6, await sec('.time')],
+  [28.8, fleetTop], [32.2, fleetEnd], [32.6, fleetEnd],
+  [33.8, await sec('#details')], [34.8, await sec('#details')],
+  [35.9, await sec('#runways')], [36.8, await sec('#runways')],
+  [37.8, await sec('#card')], [38.5, await sec('#card')],
+  [39.4, await sec('.last')], [DUR, Math.min(maxY, await sec('.last'))],
+];
+// monotone cubic through the keys, eased at every hold
+const ys = (t) => {
+  for (let i = 0; i < K.length - 1; i++) {
+    const [t0, y0] = K[i], [t1, y1] = K[i + 1];
+    if (t <= t1) { const u = (t - t0) / (t1 - t0); const e = u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2; const lin = u; const w = Math.abs(y1 - y0) > info.vh * 3 ? 0.55 : 1; return y0 + (y1 - y0) * (w * e + (1 - w) * lin); }
+  }
+  return K[K.length - 1][1];
+};
+const cdp = await p.context().newCDPSession(p);
+const N = Math.round(DUR * FPS);
+for (let i = 0; i < N; i++) {
+  const t = i / FPS;
+  await p.evaluate((s) => window.__af.step(s), { scroll: Math.round(ys(t) * 2) / 2, t });
+  await p.evaluate(() => new Promise((r) => requestAnimationFrame(() => r())));
+  const r = await cdp.send('Page.captureScreenshot', { format: 'jpeg', quality: 90 });
+  fs.writeFileSync(`${OUT}/f_${String(i).padStart(5, '0')}.jpg`, Buffer.from(r.data, 'base64'));
+  if (i % 300 === 0) console.log('frame', i, '/', N);
+}
+await b.close();
